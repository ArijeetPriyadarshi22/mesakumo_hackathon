# Export variables in your shell before starting Streamlit.
# Requesty credentials. Use REQUESTY_API_KEY or the legacy alias.
REQUESTY_API_KEY=
MESAKUMO_LLM_API_KEY=

# For live calls set the provider to requesty and approval to yes.
MESAKUMO_LLM_PROVIDER=
MESAKUMO_LLM_APPROVED=
MESAKUMO_LLM_BASE_URL=
MESAKUMO_LLM_MODEL=

# Optional workspace settings. Leave unset to use the defaults.
MESAKUMO_PARTICIPANT_DIR=
MESAKUMO_DATA_DIR=
MESAKUMO_KEEP_SESSION=
MESAKUMO_INITIAL_TENDER=
MESAKUMO_INITIAL_PAGE=
MESAKUMO_PORT=

# Automated workflow. Keep provider credentials and recipient settings local.
GEMINI_API_KEY=
MESAKUMO_AUTOMATION_DIR=
MESAKUMO_QUOTA_PROJECT=
MESAKUMO_RPM=
MESAKUMO_INPUT_TPM=
MESAKUMO_RPD=
MESAKUMO_GEMINI_MAX_OUTPUT=
MESAKUMO_EXTRACTION_BYTES=
MESAKUMO_OCR_LANGUAGES=
MESAKUMO_SOFFICE=

# Optional SMTP-over-TLS delivery. Addresses can also be set under Local folders and language.
MESAKUMO_SMTP_HOST=
MESAKUMO_SMTP_PORT=
MESAKUMO_SMTP_USER=
MESAKUMO_SMTP_PASSWORD=
MESAKUMO_SMTP_SENDER=
MESAKUMO_REVIEW_RECIPIENT=
MESAKUMO_TRIAGE_RECIPIENT=
