# Read process environment only; .env is NOT auto-loaded.
MESAKUMO_DATA_DIR=data
MESAKUMO_PORT=8501
MESAKUMO_LLM_PROVIDER=disabled
# Enable only after Mesakumo approves the model/inference region and document use.
MESAKUMO_LLM_APPROVED=no
MESAKUMO_LLM_BASE_URL=https://router.eu.requesty.ai/v1
# Obtain exact approved EU Claude model/policy ID from Mesakumo. No default.
MESAKUMO_LLM_MODEL=
MESAKUMO_LLM_API_KEY=
